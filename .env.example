# Bean & Byte runs with no environment variables: `npm ci && npm run dev`.
# Every variable below is optional and only turns on telemetry. Copy this file
# to .env.local and fill in real values to send data from your machine
# (events and metrics are tagged appRepo=local / job local/bean-and-byte).
# Never commit real .env files or secrets.

# PostHog: product analytics, feature flags, and error tracking (browser and
# server). The project key is public by design; the browser bundle inlines it.
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# OpenTelemetry traces and metrics over OTLP/HTTP (Grafana Cloud OTLP gateway).
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-us-east-0.grafana.net/otlp
OTEL_EXPORTER_OTLP_HEADERS="Authorization=Basic base64(instance_id:token)"

# Continuous profiling (Grafana Cloud Profiles / Pyroscope).
PYROSCOPE_SERVER_ADDRESS=https://profiles-prod-001.grafana.net
PYROSCOPE_BASIC_AUTH_USER=123456
PYROSCOPE_BASIC_AUTH_PASSWORD=glc_your_token

# Only for scripts/grafana-sync.mjs and the CI workflows, never the app.
GRAFANA_URL=https://your-stack.grafana.net
GRAFANA_SERVICE_ACCOUNT_TOKEN=glsa_your_token
POSTHOG_PERSONAL_API_KEY=phx_your_personal_key
