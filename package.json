{
  "name": "demo-storefront",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test:ci": "vitest run --coverage --retry=2 --reporter=default --reporter=junit --outputFile.junit=reports/junit.xml",
    "test:e2e": "playwright test",
    "knip": "knip",
    "dup:check": "jscpd app components lib server scripts e2e tests",
    "size": "size-limit",
    "todo:report": "node scripts/todo-report.mjs",
    "docs:generate": "typedoc",
    "agents:check": "node scripts/check-agents-md.mjs"
  },
  "dependencies": {
    "@vercel/otel": "^2.2.0",
    "next": "16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@size-limit/file": "^14.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.3",
    "husky": "^9.1.7",
    "jscpd": "^5.4.2",
    "knip": "^6.44.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "size-limit": "^14.3.0",
    "typedoc": "^0.28.20",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
