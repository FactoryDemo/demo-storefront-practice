{
  "folder": {
    "uid": "bean-and-byte",
    "title": "Bean & Byte"
  },
  "group": {
    "title": "bean-and-byte",
    "interval": 60
  },
  "rules": [
    {
      "uid": "bb-server-errors",
      "title": "Storefront server errors",
      "condition": "B",
      "for": "0s",
      "noDataState": "OK",
      "execErrState": "Error",
      "labels": {
        "service": "bean-and-byte",
        "severity": "critical"
      },
      "annotations": {
        "summary": "An API route threw an unhandled error in the last 5 minutes. Check PostHog error tracking for the stack and the session.",
        "runbook_url": "https://github.com/FactoryDemo/demo-storefront/blob/main/docs/runbooks/observability.md"
      },
      "data": [
        {
          "refId": "A",
          "datasourceUid": "__PROMETHEUS__",
          "relativeTimeRange": {
            "from": 900,
            "to": 0
          },
          "model": {
            "refId": "A",
            "expr": "sum by (job) (increase(server_errors_total{job=~\".+/bean-and-byte\"}[5m]))",
            "instant": true,
            "intervalMs": 1000,
            "maxDataPoints": 43200
          }
        },
        {
          "refId": "B",
          "datasourceUid": "__expr__",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "model": {
            "refId": "B",
            "type": "threshold",
            "expression": "A",
            "conditions": [
              {
                "evaluator": {
                  "type": "gt",
                  "params": [0]
                }
              }
            ]
          }
        }
      ]
    },
    {
      "uid": "bb-order-rejections",
      "title": "Storefront order rejections high",
      "condition": "B",
      "for": "5m",
      "noDataState": "OK",
      "execErrState": "Error",
      "labels": {
        "service": "bean-and-byte",
        "severity": "warning"
      },
      "annotations": {
        "summary": "More than 25 orders were rejected in 15 minutes. Checkout may be sending bad requests, or someone is hammering the API.",
        "runbook_url": "https://github.com/FactoryDemo/demo-storefront/blob/main/docs/runbooks/observability.md"
      },
      "data": [
        {
          "refId": "A",
          "datasourceUid": "__PROMETHEUS__",
          "relativeTimeRange": {
            "from": 900,
            "to": 0
          },
          "model": {
            "refId": "A",
            "expr": "sum by (job) (increase(orders_rejected_total{job=~\".+/bean-and-byte\"}[15m]))",
            "instant": true,
            "intervalMs": 1000,
            "maxDataPoints": 43200
          }
        },
        {
          "refId": "B",
          "datasourceUid": "__expr__",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "model": {
            "refId": "B",
            "type": "threshold",
            "expression": "A",
            "conditions": [
              {
                "evaluator": {
                  "type": "gt",
                  "params": [25]
                }
              }
            ]
          }
        }
      ]
    }
  ]
}
